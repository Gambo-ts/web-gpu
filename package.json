{
  "name": "gambo-starter-ts",
  "version": "1.0.0",
  "description": "Gambo Starter — a TypeScript + WebGPU lesson scaffold",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md,html}\"",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "dat.gui": "^0.7.9",
    "wgpu-matrix": "^3.3.0"
  },
  "devDependencies": {
    "@types/dat.gui": "^0.7.13",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@webgpu/types": "^0.1.70",
    "canvas": "^3.2.3",
    "eslint": "^10.9.1",
    "glob": "^13.0.6",
    "minisearch": "^6.3.0",
    "prettier": "^3.9.6",
    "rollup": "^4.63.0",
    "shiki": "^4.4.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitepress": "^1.6.4"
  }
}
